<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="1">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".2"
        android:contentDescription="@string/coin_image"
        android:padding="5dp"
        android:src="@drawable/coin"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight=".6"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coin_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/coin_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/coin_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/coin_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee" />

        <View
            style="@style/Divider"
            android:layout_marginTop="@dimen/list_item_vertical_margin" />

    </LinearLayout>

    <TextView
        android:id="@+id/coin_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight=".2" />

</LinearLayout>