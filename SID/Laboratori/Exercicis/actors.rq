PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resources/>
PREFIX dbp: <http://dbpedia.org/property/>

SELECT DISTINCT ?actor, (COUNT(?award) as ?num)
WHERE {
    ?actor dbp:name ?nombreActor.
    ?actor dbo:award ?award.
    (?actor a dbo:Actor.) UNION (?actor. dbo:occupation "Actor"@en.)
}
GROUP BY ?actor
having (COUNT(?award) > 1)
LIMIT 50